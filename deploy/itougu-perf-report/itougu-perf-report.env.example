# ==== /etc/itougu-perf-report.env （chmod 600, root:root）====
# 飞书应用凭据；部署脚本会在文件缺失时从 /etc/itougu-neican.env 自动带过来。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# itougu 长效 token（与轮询服务共用同一份）
ITOUGU_AUTH_FILE=/opt/itougu-neican/itougu_auth.json
# 远端不读工作站的 .env
ITOUGU_ENV_FILE=/dev/null
# 交易流水 ledger + 已发送日/周报记录；上游窗口滚掉后靠它保住建仓价
ITOUGU_PERF_STATE_FILE=/var/lib/itougu-neican/perf-report.json
# 产品 → 目标飞书群：<businessProductId>=<chat_id>[,<chat_id>]，多个产品用 ; 分隔
# 1806593447818383361 = 尾盘掘金内参 → 分析师发送汇总群（不投递尾盘掘金专属群）
# 1661993558510538753 = 猎场擒龙内参 → 擒龙内参更新群1
ITOUGU_PERF_TARGETS=1806593447818383361=oc_523b7e9e29854acba64272a948cb8eda;1661993558510538753=oc_cf156f51d085e2c51bd66fda198b88a0

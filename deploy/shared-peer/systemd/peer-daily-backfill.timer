[Unit]
Description=Backfill the daily history in the owner batch window

[Timer]
# Keep bulk history/COPY work on the independent owner lane during 04:00-08:00;
# the live 5432/session process remains untouched during market hours.
OnCalendar=Mon..Fri 06:30 Asia/Shanghai
Persistent=false
AccuracySec=1min
Unit=peer-daily-backfill.service

[Install]
WantedBy=timers.target

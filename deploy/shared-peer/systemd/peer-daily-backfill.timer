[Unit]
Description=Backfill the daily history after the close

[Timer]
# 15:40 is past the close and past the post-close refresh window, so the
# backfill never competes with live collection for the shared 6-per-minute
# provider - during a session that race is lost every time, and the request
# returns "shared provider rate-limit queue is full".
OnCalendar=Mon..Fri 15:40 Asia/Shanghai
Persistent=false
AccuracySec=1min
Unit=peer-daily-backfill.service

[Install]
WantedBy=timers.target

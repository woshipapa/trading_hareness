PEER_SSH_HOST=your-lightserver-host
PEER_SSH_PORT=3535
PEER_SSH_USER=stockpeer
PEER_SSH_KEY_PATH=/home/stockpeer/.ssh/id_ed25519
PEER_KNOWN_HOSTS_PATH=/home/stockpeer/.ssh/known_hosts
# Set only when PEER_SSH_HOST is a routing-internal address (VPN/overlay IP)
# that can differ from the stable public identity known_hosts is keyed to,
# e.g. PEER_SSH_HOST_KEY_ALIAS=[your-lightserver-public-host]:3535. Leave
# blank when PEER_SSH_HOST is itself the stable address.
PEER_SSH_HOST_KEY_ALIAS=
REMOTE_DB_PORT=15432
REMOTE_API_PORT=15681
# Independent bulk tunnel: owner task trading-hareness-shared-peer-batch-tunnel
# publishes 127.0.0.1:15433 -> 127.0.0.1:55432; peer container listens on 5433.
REMOTE_BATCH_DB_PORT=15433

PEER_DB_USER=stock_peer
PEER_DB_PASSWORD=replace-me
PEER_QUANT_DATABASE=trading_hareness
PEER_N8N_DATABASE=trading_hareness_peer_n8n
# On a workstation this must remain false: local is analysis/read-through only.
# The remote owner/peer deployment is the only real-time writer and sets its own
# intraday profile explicitly.
PEER_BACKGROUND_TASKS_ENABLED=false
# The normal db-tunnel now exposes the owner batch reverse on 5433. Keep
# intraday quant-research on 5432; only the research scheduler uses this lane.
PEER_RESEARCH_DB_HOST=db-tunnel
PEER_RESEARCH_DB_PORT=5433
# The scheduler is now on db-tunnel:5433; the guard remains explicit so a
# missing owner reverse blocks startup instead of silently falling back.
PEER_REQUIRE_OWNER_CUTOVER=auto
# The peer gate checks only the owner runtime contract: canonical bar columns
# and daily_adjustment_factors.raw. adjustment_state is a computed peer view;
# factor semantics are read from raw JSON. No owner DDL or cold market twins
# are required, and a missing factor row remains a fail-closed data result.
PEER_REQUIRE_OWNER_SEMANTICS=true
# The first restart is report-only and records a receipt. Set block only after
# that receipt has been observed and the live contract is stable.
PEER_OWNER_CONTRACT_MODE=report_only
PEER_OWNER_CONTRACT_RECEIPT_PATH=/var/lib/quant/owner-peer-contract.json
# auto keeps the batch lane inferred from the scheduler's db-tunnel:5433 route.
# Set true only after the owner reverse task is installed; false deliberately
# excludes it from the guard for an offline diagnostic.
PEER_BATCH_TUNNEL_REQUIRED=auto
QUANT_SKIP_MIGRATIONS=true
PEER_QUANT_WRITE_API_KEY=replace-me
QUANT_SHARED_READ_API_KEY=replace-me
PEER_N8N_ENCRYPTION_KEY=replace-me
PEER_QUANT_PORT=15682
# Owner async read pool budget; keep this aligned with the provisioned owner connections.
PEER_RESEARCH_ASYNC_READ_POOL_MAX_SIZE=16
PEER_N8N_PORT=15678
PEER_WHEELHOUSE_PATH=/home/stockpeer/wheelhouse
# Immutable peer image provenance. The release activation helper fills the
# release id when this is absent; keep the git SHA/build time from the build
# receipt when available so verifier output can identify the running image.
PEER_APP_GIT_SHA=unknown
PEER_APP_RELEASE=unknown
PEER_APP_BUILD_CREATED_AT=unknown
# Optional verifier pin. If set, --stage lane/complete also requires the API
# health build.release to equal this exact value.
PEER_EXPECTED_RELEASE=
# Optional source-only hotfix overlay. Keep disabled unless an operator has
# staged and compiled a retained release with scripts/hotfix-quant-service.sh.
QUANT_HOTFIX_ENABLED=false
QUANT_HOTFIX_HOST_DIR=/home/stockpeer/trading_hareness/hotfix/quant-service
PEER_DAILY_SUMMARY_FEISHU_ENABLED=true

# Copy values from the local ignored .env during deployment. Never commit relay.env.
RELAY_PGDATABASE=n8n_relay
RELAY_PGUSER=relay_n8n
RELAY_PGPASSWORD=
N8N_ENCRYPTION_KEY=
QUANT_WRITE_API_KEY=
APP_GIT_SHA=
APP_RELEASE=
APP_BUILD_CREATED_AT=
FEISHU_ADAPTER_IMAGE=
# Source hotfix overlay for the adapter and LarkAgentX bridge. The hotfix
# script manages these values; leave adapter selection disabled for a normal
# immutable image release.
FEISHU_ADAPTER_HOTFIX_ENABLED=false
FEISHU_ADAPTER_HOTFIX_DIR=/opt/feishu-relay-edge/hotfix
LARKX_BRIDGE_HOTFIX_ROOT=/opt/feishu-relay-edge/hotfix
# Private-session bridge safety. Each profile gets separate credentials,
# SQLite event spool and owner lock under LARKX_HOME. Keep this path on the
# persistent, permission-restricted host filesystem.
LARKX_PROFILE=default
LARKX_HOME=/var/lib/larkagentx
LARKX_EVENT_SPOOL_DB=/var/lib/larkagentx/bridge-events.sqlite3
LARKX_OWNER_LOCK_PATH=/var/lib/larkagentx/bridge.owner.lock
LARKX_SPOOL_REPLAY_SECONDS=30
LARKX_SUMMARY_CHAT_IDS=
LARKX_SUMMARY_INGRESS_URL=http://127.0.0.1:18300/internal/larkagentx/summary
LARKX_GAP_REPAIR_ENABLED=false
LARKX_OFFICIAL_FALLBACK_ENABLED=false
BAIDU_PAN_MARKET_ARCHIVE_ENABLED=false
BAIDU_PAN_MARKET_ARCHIVE_INTERVAL_SECONDS=30
BAIDU_PAN_MARKET_ARCHIVE_ROOT_PATH=/apps/股票paper存储/market-realtime
# Raw overflow lane (requires QUANT_RAW_OVERFLOW_ARCHIVE_ENABLED=true on the
# edge quant service as well; keep both false until the ACK/restore drill).
BAIDU_PAN_RAW_OVERFLOW_ENABLED=false
BAIDU_PAN_RAW_OVERFLOW_CAPABILITIES=a_share_prices_snapshot,realtime_quote,order_book_quote,rt_k,rt_min,rt_min_daily
BAIDU_PAN_RAW_OVERFLOW_BATCH_ROWS=100
BAIDU_PAN_RAW_OVERFLOW_BATCHES_PER_DRAIN=4
BAIDU_PAN_RAW_OVERFLOW_ROOT_PATH=/apps/股票paper存储/quant-lake/v1/raw-overflow
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_GROUP_RELAY_ENABLED=false
FEISHU_GROUP_RELAY_WEBHOOK_KEYWORDS=
FEISHU_SUMMARY_LISTENER_ENABLED=false
FEISHU_LONG_CONNECTION_ENABLED=false
# Optional Baidu Netdisk personal-app archive. Keep credentials outside Git.
BAIDU_PAN_ENABLED=false
BAIDU_PAN_APP_KEY=
BAIDU_PAN_SECRET_KEY=
BAIDU_PAN_REDIRECT_URI=oob
BAIDU_PAN_ROOT_PATH=/apps/股票paper存储/feishu-relay
BAIDU_PAN_SPOOL_DIR=/var/lib/adapter-ingestion/baidu-pan-spool
BAIDU_PAN_MAX_UPLOAD_BYTES=524288000
BAIDU_PAN_SLICE_BYTES=4194304
BAIDU_PAN_ARCHIVE_PROVIDER=auto

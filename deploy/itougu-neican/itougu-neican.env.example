# ==== /etc/itougu-neican.env （chmod 600, root:root）====
# 飞书应用凭据（复用 feishu-relay-edge 那个飞书应用的 App ID/Secret）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# itougu 长效 token 文件（从本地 wechat-export-macos/itougu_auth.json 拷到远端）
ITOUGU_AUTH_FILE=/opt/itougu-neican/itougu_auth.json
# 去重状态文件（记已发 appendContentId）
ITOUGU_STATE_FILE=/var/lib/itougu-neican/state.json
# 目标飞书群（公众号同步群）
ITOUGU_CHAT_IDS=oc_570aeb3bbfb11fa2be66b25ca4568aad
# 远端不读本地 mac 的 .env
ITOUGU_ENV_FILE=/dev/null
# 尾盘掘金内参的专属出口；可与 ITOUGU_CHAT_IDS 同时保留
ITOUGU_JUEJIN_CHAT_IDS=oc_844b3ba7c44c1d3cdb43184b2630fad2
# 本机文章监听（研习社、尾盘掘金）使用；远端轮询本身不抓文章
ITOUGU_ARTICLE_CHAT_IDS=oc_844b3ba7c44c1d3cdb43184b2630fad2
# 仅用于一次性冒烟测试：非空时覆盖所有产品专用群，必须指向公众号同步群；生产留空
ITOUGU_TEST_CHAT_IDS=
# 动态水印 HMAC 密钥（可选）；不设置时在 ITOUGU_STATE_FILE 旁自动生成 0600 密钥文件
# ITOUGU_WATERMARK_SECRET=
# ITOUGU_WATERMARK_SECRET_FILE=/var/lib/itougu-neican/state.json.watermark-secret
# CJK 字体（edge 默认由 fonts-noto-cjk 提供）
# ITOUGU_WATERMARK_FONT_FILE=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# 彩色 Emoji 字体（edge 默认由 fonts-noto-color-emoji 提供）
# ITOUGU_EMOJI_FONT_FILE=/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf
# 单向发送群改走自定义机器人 webhook，不占用飞书应用的月度 API 调用量。
# 格式：<chat_id>=<webhook_url>[;<chat_id2>=<webhook_url2>...]；配置了的 chat_id
# 在 send_feishu 里优先走这里，未配置的沿用原有应用接口发送。图片类卡片仍需
# 应用身份上传 image_key（自定义机器人不能自己上传图片），只有消息发送本身
# 移出配额；纯文本/富文本群配上 webhook 后可以做到发送环节完全零调用量。
# 每个 webhook 群建议开「自定义关键词」安全设置，关键词取消息标题里本来就有
# 的产品名子串（如"擒龙内参"），这样不用改代码也能通过校验。
# webhook 地址本身是可用凭据，不要把真实值提交进仓库；只写进
# /etc/itougu-neican.env（0600）。示例（占位符）：
# ITOUGU_FEISHU_WEBHOOKS=oc_your_chat_id=https://open.feishu.cn/open-apis/bot/v2/hook/your-hook-id
# 可选关键词：chat_id=关键词;chat_id2=关键词2。仅写入对应 webhook 的可见标题。
# 每个启用关键词校验的自定义机器人都必须配置关键词；例如：
# ITOUGU_FEISHU_WEBHOOK_KEYWORDS=oc_summary=汇总;oc_tailpan=尾盘掘金

{
  "schema_version": 1,
  "integration_paths": [
    ".github/**",
    "config/**",
    "deploy/**",
    "docs/**",
    "scripts/**",
    "compose.yaml",
    "compose.*.yaml",
    ".env.example",
    "AGENTS.md",
    "workflows/paper-kb-automation.json",
    "workflows/runner-*.json",
    "workflows/managed/**",
    "frontend-shared/**"
  ],
  "components": [
    {
      "id": "quant-research",
      "paths": [
        "quant-service/**",
        "frontend/**",
        "deploy/shared-peer/**",
        "workflows/quant-*.json"
      ],
      "manifest": "quant-service/component.json",
      "runtime": "47owner",
      "release": "owner-quant",
      "release_units": [
        "owner-quant",
        "owner-schema",
        "edge-quant-console"
      ],
      "owned_data": {
        "schemas": [
          "quant"
        ],
        "note": "quant-service/migrations 是这个 schema 唯一的 DDL 来源；别的组件读它要在 foreign_data_contracts 里逐表申报。"
      },
      "standalone": {
        "build_context": "quant-service",
        "dockerfile": "quant-service/Dockerfile.standalone",
        "compose": "quant-service/compose.standalone.yaml",
        "entrypoint": "quant-service/entrypoint.py",
        "external_contracts": [
          "PostgreSQL quant schema",
          "provider credentials"
        ]
      },
      "tests": [
        "make -C quant-service test-release-path",
        "cd frontend && npm run typecheck && npm run build"
      ],
      "services": [
        "quant-research",
        "quant-research-worker",
        "quant-research-preflight",
        "quant-research-gateway",
        "quant-research-scheduler"
      ]
    },
    {
      "id": "feishu-relay",
      "paths": [
        "feishu-relay/**",
        "workflows/edge-relay/**"
      ],
      "manifest": "feishu-relay/component.json",
      "runtime": "47edge",
      "release": "edge-relay",
      "release_units": [
        "edge-relay",
        "edge-workflows"
      ],
      "owned_data": {
        "objects": [
          "public.analysis_jobs",
          "public.baidu_pan_archive_jobs",
          "public.baidu_pan_oauth_tokens",
          "public.feishu_group_relay_actions",
          "public.feishu_group_relay_messages",
          "public.feishu_group_relay_route_state",
          "public.feishu_group_relay_routes",
          "public.feishu_group_relay_sources",
          "public.feishu_relay_writer_ownership",
          "public.feishu_summary_listener_state",
          "public.feishu_user_oauth_tokens",
          "public.ingestion_asset_parts",
          "public.ingestion_assets",
          "public.ingestion_content_items",
          "public.ingestion_delivery_outbox",
          "public.ingestion_errors",
          "public.ingestion_jobs",
          "public.ingestion_publishers",
          "public.ingestion_source_profiles",
          "public.ingestion_topics",
          "public.paper_kb_deliveries"
        ],
        "note": "中继台账建在 n8n 库的 public schema 里（adapter/ledger.mjs 建表，不带 schema 前缀）。public 本身不归任何组件 —— n8n 自己的表也在里面 —— 所以只按表声明。检查器核对每一张都确实由本组件代码创建。"
      },
      "standalone": {
        "build_context": "feishu-relay",
        "dockerfile": "feishu-relay/adapter/Dockerfile.standalone",
        "compose": "feishu-relay/compose.standalone.yaml",
        "entrypoint": "feishu-relay/adapter/index.mjs",
        "external_contracts": [
          "PostgreSQL relay ledger",
          "Feishu app credentials",
          "webhook targets"
        ],
        "supporting_runtimes": [
          {
            "id": "larkagentx-bridge",
            "dockerfile": "feishu-relay/bridge/Dockerfile.runtime",
            "entrypoint": "feishu-relay/bridge/bridge.py",
            "external_contracts": [
              "pinned LarkAgentX checkout",
              "private account auth",
              "allowlisted chat IDs"
            ]
          }
        ]
      },
      "tests": [
        "npm install --prefix feishu-relay/adapter --no-audit --no-fund",
        "node --test feishu-relay/adapter/*.test.mjs",
        "python3 -m unittest discover -s feishu-relay/bridge -p 'test_*.py' -q",
        "cd feishu-relay/dashboard && npm run typecheck && npm test -- --run && npm run build"
      ],
      "services": [
        "feishu-adapter",
        "larkagentx-bridge"
      ]
    },
    {
      "id": "xhs-intel",
      "paths": [
        "xhs-intel/**",
        "workflows/xhs-intel-edge.json"
      ],
      "manifest": "xhs-intel/component.json",
      "runtime": "47edge",
      "release": "edge-xhs",
      "release_units": [
        "edge-xhs"
      ],
      "standalone": {
        "build_context": "xhs-intel",
        "dockerfile": "xhs-intel/Dockerfile.runtime",
        "compose": "xhs-intel/compose.standalone.yaml",
        "entrypoint": "xhs-intel/edge_api.py",
        "external_contracts": [
          "pinned Spider_XHS source mount",
          "XHS cookie",
          "optional Feishu webhook"
        ]
      },
      "tests": [
        "python3 -m unittest discover -s xhs-intel -p 'test_*.py' -q",
        "node --check xhs-intel/dashboard/app.js",
        "node xhs-intel/scripts/deploy-xhs-intel-edge.test.mjs"
      ],
      "services": [
        "xhs-collector"
      ]
    }
  ],
  "hosts": [
    {
      "id": "47owner",
      "role": "owner/peer 实时数据面：唯一的 provider 轮询、扫描、租约调度与生产写入方",
      "components": [
        "quant-research"
      ],
      "processes": [
        "rootless Docker 项目 trading-hareness-peer：db-tunnel（5432 会话、5433 批量、5681 API，经反向隧道到 owner-windows）、db-batch-tunnel（兼容 sidecar）",
        "quant-research：QUANT_RUNTIME_PROFILE=intraday_edge，127.0.0.1:15682",
        "quant-research-scheduler：research profile，127.0.0.1:15683；必须在主服务健康之后启动",
        "systemd 用户定时器：peer-session-guard-heal（2 分钟）、peer-session-guard-preopen（08:40/09:10）、peer-daily-backfill（06:30）"
      ],
      "release": "代码：scripts/shared-peer/deploy-code-only.sh；完整：docs/RELEASE_SYNC_47.md 阶段 F。两者都持有 scripts/shared-peer/release-lock.sh 的守护锁。",
      "credentials": "~/.secrets/owner/.env.owner，由 config/secrets/sync-secrets.sh owner 推送；compose 的 .env 与 intraday-secrets.env 都是指向它的软链接",
      "writes": [
        "owner PostgreSQL 的 quant schema（经 db-tunnel）"
      ]
    },
    {
      "id": "owner-windows",
      "role": "owner 的数据库与上游供应商凭据所在地；peer 只经它发起的反向隧道访问",
      "components": [
        "quant-research"
      ],
      "processes": [
        "PostgreSQL 热库 127.0.0.1:55432 + stock_cold 表空间",
        "quant API 127.0.0.1:5681（scripts/windows/start-stock-platform.ps1：research profile，后台任务关闭；Longhu 网关）",
        "持久反向 SSH：15432 会话、15433 批量、15681 API 到 47owner"
      ],
      "release": "docs/RELEASE_SYNC_47.md 阶段 D（迁移，先于任何代码切换）与阶段 G（Windows API）",
      "credentials": "G:\\StockPlatform\\config\\runtime.env，由 owner 自己保管，不从本仓库同步",
      "writes": [
        "它就是数据库；owner-schema 迁移在这里执行"
      ]
    },
    {
      "id": "47edge",
      "role": "飞书中继、n8n 工作流、小红书采集，以及同源托管的两个前端；没有任何 quant 写入者",
      "components": [
        "feishu-relay",
        "xhs-intel",
        "quant-research"
      ],
      "processes": [
        "Docker 项目 feishu-relay-edge：feishu-adapter（同源托管飞书面板与 quant 控制台 edge-quant-console）、n8n、n8n-runners、xhs-collector",
        "systemd：larkagentx-group-relay.service（LarkAgentX bridge）"
      ],
      "retired": [
        "quant-intraday-edge.service：2026-09 退役并 disable；docs/RELEASE_SYNC_47.md 铁律 1 禁止再启用"
      ],
      "release": "feishu-relay/scripts/edge/hotfix-feishu-relay-edge.sh、scripts/edge/deploy-quant-console-edge.sh、xhs-intel/scripts/hotfix-xhs-intel-edge.sh",
      "credentials": "~/.secrets/edge/.env.edge，由 config/secrets/sync-secrets.sh edge 推送",
      "writes": [
        "n8n 库 public schema 里的中继台账（owned_data）",
        "xhs-intel 自己的 SQLite 队列"
      ]
    },
    {
      "id": "workstation",
      "role": "运维与研究工作站：只读分析、发布操作、个人自动化；不是任何生产数据的事实源",
      "components": [],
      "processes": [
        "launchd com.papa.svc-supervisor 运行 scripts/svc_supervisor.py 的任务（下面逐个分类）",
        "本地开发栈 compose.yaml（127.0.0.1:5681，只做本地验证，不是 owner 数据）"
      ],
      "release": "无：本机直接运行工作树",
      "credentials": "config/secrets/.env.local（唯一真源）",
      "writes": [
        "teacher.cycle：经 ssh + docker exec，在 47owner 的 peer 容器里运行 app.teacher_review_ops 导入老师复盘包 —— 这是 HTTP 写边界之外唯一的 owner 写入口"
      ],
      "supervisor_tasks": {
        "teacher.cycle": "owner-writer",
        "video-harness": "owner-reader",
        "video.ingest": "owner-reader",
        "owner-tunnel": "tunnel",
        "feishu-tunnel": "tunnel",
        "xhs-edge-tunnel": "tunnel",
        "paper-kb-webhook-tunnel": "tunnel",
        "xhs-ai-worker": "edge-client",
        "itougu-table-watch": "local",
        "model-service": "local",
        "agent-skills.web": "local",
        "b300-collab.watch": "local",
        "paperkb.*": "local",
        "watchlist.sync": "retired",
        "watchlist.refresh": "retired"
      }
    }
  ],
  "foreign_data_contracts": [
    {
      "consumer": "quant-research",
      "object": "public.workflow_entity",
      "owner": "n8n",
      "kind": "read",
      "sites": [
        "quant-service/app/n8n_workflow_audit.py"
      ],
      "note": "第三方内部 schema；只允许在这一个适配器里出现，读不到时按未知上报。"
    },
    {
      "consumer": "quant-research",
      "object": "public.workflow_published_version",
      "owner": "n8n",
      "kind": "read",
      "sites": [
        "quant-service/app/n8n_workflow_audit.py"
      ],
      "note": "同上。"
    },
    {
      "consumer": "quant-research",
      "object": "public.execution_entity",
      "owner": "n8n",
      "kind": "read",
      "sites": [
        "quant-service/app/n8n_workflow_audit.py"
      ],
      "note": "同上。"
    },
    {
      "consumer": "feishu-relay",
      "objects": [
        "quant.analyst_evidence",
        "quant.analyst_observations",
        "quant.canonical_bars_daily",
        "quant.daily_adjustment_factors",
        "quant.daily_fundamentals",
        "quant.daily_trade_limits",
        "quant.intraday_board_flow_snapshots",
        "quant.intraday_quote_observations",
        "quant.intraday_rule_input_snapshots",
        "quant.intraday_signal_events",
        "quant.market_bars_minute",
        "quant.market_events",
        "quant.post_close_strategy_candidates",
        "quant.post_close_strategy_runs",
        "quant.post_close_strategy_screen_observations",
        "quant.raw_market_observations",
        "quant.sector_member_sync_state",
        "quant.sector_membership_history",
        "quant.sentiment_cycle_daily",
        "quant.stock_money_flow_daily",
        "quant.ten_day_leader_rotation_intraday_observations",
        "quant.tushare_raw_records",
        "quant.xiaojie_leader_flow_observations"
      ],
      "owner": "quant-research",
      "kind": "read",
      "sites": [
        "feishu-relay/scripts/media/baidu-pan-history-export.mjs"
      ],
      "note": "遗留归档工具：把 edge 上已退役的 quant schema（2026-09-05 边缘写入者退役前的数据）按天导出到百度盘。只读、手工运行、不在任何服务的请求路径上。owner 的 quant 数据走 /api/v1 契约（baidu-pan-market-archive.mjs），不得照这里直连。edge 旧库清空后应连同脚本一起删除。"
    }
  ],
  "shared_runtime_databases": [
    {
      "compose": "deploy/compose.server.yaml",
      "database": "n8n",
      "components": [
        "feishu-relay",
        "quant-research"
      ],
      "note": "单机一体化部署模板（DEPLOYMENT.md、scripts/deploy-server.sh：Caddy + 两个域名）把 feishu-adapter 和 quant-research* 放进同一个 n8n 库。2026-10-08 核对：47owner 跑的是 shared-peer 栈（quant 与 n8n 分库），47edge 跑的是 feishu-relay-edge，两台都没有部署这个模板 —— 共库只在有人按模板部署时才成立。quant schema 已不依赖中继台账（20261008_sep0002 去掉了外键，bootstrap 不再要求 public.ingestion_jobs），所以按模板部署时两边只是同库、不再耦合。"
    },
    {
      "compose": "compose.yaml",
      "database": "n8n",
      "components": [
        "feishu-relay",
        "quant-research"
      ],
      "note": "本机开发栈，与 owner 主栈同形；拆分时要一起改，否则本地测不出隔离回归。"
    }
  ],
  "cross_unit_artifacts": [
    {
      "artifact": "frontend/dist",
      "owned_by": "quant-research",
      "published_by": "edge-quant-console",
      "publisher": "scripts/edge/deploy-quant-console-edge.sh",
      "served_from": "47edge",
      "serves_at": "/app/hotfix/quant-console/current",
      "note": "quant 控制台（策略与实时数据）的源码属 quant-research，运行位置在 47edge —— 适配器同源代理两个 SPA，所以它必须和飞书面板同源。但它现在是**独立发布单元**：有自己的 hotfix/quant-console/{releases,current}，由 scripts/edge/deploy-quant-console-edge.sh 发布。中继热部署不再构建或发布它，中继的脏检查也不再包含 frontend/；反过来发控制台也不碰中继的 releases。首次切换顺序：先发控制台（目录要先存在），再发中继 —— 目录缺失时适配器会退回镜像内副本，是降级而不是 404。"
    }
  ],
  "hot_update_paths": {
    "quant-research": {
      "script": "scripts/shared-peer/deploy-code-only.sh",
      "unit": "owner-quant",
      "reuses_image": true,
      "full_release_required_when": [
        "requirements.txt / 锁文件 / Dockerfile / compose / 系统包 / supervisor 契约",
        "quant-service/migrations/versions/*.py（注释与 docstring 改动除外）"
      ]
    },
    "edge-quant-console": {
      "script": "scripts/edge/deploy-quant-console-edge.sh",
      "unit": "edge-quant-console",
      "reuses_image": true,
      "full_release_required_when": [
        "无 —— 纯静态资源，适配器按请求读目录"
      ]
    },
    "feishu-relay": {
      "script": "feishu-relay/scripts/edge/hotfix-feishu-relay-edge.sh",
      "unit": "edge-relay",
      "reuses_image": true,
      "full_release_required_when": [
        "adapter/package.json 的依赖字段变化（scripts 等无关字段不算）"
      ]
    },
    "xhs-intel": {
      "script": "xhs-intel/scripts/hotfix-xhs-intel-edge.sh",
      "unit": "edge-xhs",
      "reuses_image": true,
      "full_release_required_when": [
        "xhs-intel/requirements.txt 与运行镜像里烤进去的那份不一致",
        "xhs-intel/Dockerfile 变化（基础镜像、系统包、npm ci 都在里面）",
        "外部 Spider_XHS（xhs-source）变化 —— 走 xhs-intel/scripts/deploy-xhs-intel-edge.sh"
      ]
    }
  }
}

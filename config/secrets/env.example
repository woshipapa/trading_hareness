# ╔══════════════════════════════════════════════════════════════════════╗
# ║ 凭据模板 — 只有键名，没有值                                        ║
# ║ cp env.example .env.local  然后填值                                ║
# ║ .env.owner / .env.edge 用同样的键名，值按环境填                    ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── 1. 微信中继 ──────────────────────────────────────────────────────
RELAY_TOKEN=                          # 微信群消息→47 adapter 端点鉴权
WECHAT_GROUP_RELAY_ENDPOINT_TOKEN=    # = RELAY_TOKEN（远端侧名称）
WECHAT_GROUP_RELAY_SOURCE_KEY=        # 中继来源标识

# ── 2. 飞书 ──────────────────────────────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALERT_RECEIVE_ID=             # 告警消息接收 ID
FEISHU_ALERT_RECEIVE_ID_TYPE=        # user / chat
FEISHU_SUMMARY_LISTENER_ENABLED=     # true/false
FEISHU_GROUP_RELAY_ENABLED=          # true/false
WECHAT_BIZ_FEISHU_WEBHOOKS=          # JSON array of webhook URLs

# ── 3. 百度网盘 ──────────────────────────────────────────────────────
BAIDU_PAN_APP_KEY=
BAIDU_PAN_SECRET_KEY=
BAIDU_PAN_REDIRECT_URI=
BAIDU_PAN_ROOT_PATH=
BAIDU_PAN_ENABLED=                   # true/false
BAIDU_PAN_ARCHIVE_PROVIDER=
BAIDU_PAN_MARKET_ARCHIVE_ENABLED=
BAIDU_PAN_MARKET_ARCHIVE_INTERVAL_SECONDS=
BAIDU_PAN_MARKET_ARCHIVE_ROOT_PATH=
BAIDU_PAN_RAW_OVERFLOW_ENABLED=
BAIDU_PAN_RAW_OVERFLOW_ROOT_PATH=
BAIDU_PAN_RAW_OVERFLOW_CAPABILITIES=

# ── 4. 量化服务读写鉴权 ─────────────────────────────────────────────
QUANT_SHARED_READ_API_KEY=           # Longhu 共享网关 / edge peer 只读
QUANT_SHARED_READ_API_BASE_URL=      # http://127.0.0.1:15682 (owner) 或 peer 容器内
QUANT_WRITE_API_KEY=                 # quant-service 写入鉴权
QUANT_ALERT_WEBHOOK_TOKEN=           # 告警 webhook 鉴权
QUANT_RUNTIME_PROFILE=               # production / development

# ── 5. SSH 隧道（owner read path）───────────────────────────────────
LONGHU_SSH_HOST=
LONGHU_SSH_PORT=
LONGHU_SSH_USER=
LONGHU_SSH_KEY_PATH=                 # → ~/.ssh/ 下，绝不入库
LONGHU_LOCAL_PORT=
LONGHU_REMOTE_PORT=

# ── 6. 数据源 API ───────────────────────────────────────────────────
TUSHARE_TOKEN=
TUSHARE_SUPER_TOKEN=
TUSHARE_SUPER_GET_API_KEY=
TUSHARE_SUPER_REALTIME_API_KEY=
TUSHARE_SUPER_REALTIME_FALLBACK_API_KEY=
TUSHARE_BACKUP_API_KEY=
TUSHARE_API_URL=
TUSHARE_BACKUP_API_URL=
TUSHARE_SUPER_API_URL=
TUSHARE_SUPER_GET_API_URL=
TUSHARE_SUPER_REALTIME_API_URL=
TUSHARE_SUPER_GET_PROXY_URL=
TUSHARE_SUPER_REALTIME_PROXY_URL=
TUSHARE_SUPER_PROXY_URL=
TUSHARE_SUPER_GET_MODE=
TUSHARE_SUPER_GET_REQUESTS_PER_MINUTE=
TUSHARE_SUPER_GET_MIN_INTERVAL_SECONDS=
TUSHARE_SUPER_REALTIME_REQUESTS_PER_MINUTE=
FUYAO_API_KEY=

# ── 7. 基础设施 ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=                   # 本地 compose Postgres
N8N_ENCRYPTION_KEY=                  # n8n 凭据库加密密钥
N8N_API_KEY=                         # n8n REST API

# ── 8. 远端数据库（edge.env / owner.env）─────────────────────────────
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# ── 9. Paper KB ──────────────────────────────────────────────────────
PAPER_KB_FEEDBACK_WEBHOOK=
PAPER_KB_FEISHU_CHAT_ID=
PAPER_KB_FEISHU_WEBHOOK_URL=
PAPER_KB_INGEST_WEBHOOK=
PAPER_KB_SEARCH_WEBHOOK=
PAPER_KB_JOBS_TOKEN=

# ── 10. XHS 采集 ────────────────────────────────────────────────────
XHS_COLLECTOR_TOKEN=                 # xhs-collector 采集鉴权
XHS_ADMIN_OPEN_IDS=                  # 允许审批的飞书 Open ID 列表

# ── 11. HuggingFace ──────────────────────────────────────────────────
HF_TOKEN=                            # HuggingFace Hub 访问

# ── 12. 远端归档 ────────────────────────────────────────────────────
REMOTE_ANALYST_ARCHIVE_BASE_URL=     # 分析师远端归档目标

# ── 13. 证书 ────────────────────────────────────────────────────────
# PEM/密钥文件放在 config/secrets/certs/，不在此文件
# market-review-api.pem → certs/market-review-api.pem

FROM python:3.12-slim

WORKDIR /app
COPY bridge/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY bridge/*.py ./

# LarkAgentX is an external, pinned client checkout. Mount it at runtime;
# bridge code and adapter communicate over HTTP and do not import quant code.
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/larkagentx:/app
EXPOSE 8090
CMD ["python", "bridge.py"]

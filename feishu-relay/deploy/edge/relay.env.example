# Copy values from the local ignored .env during deployment. Never commit relay.env.
RELAY_PGDATABASE=n8n_relay
RELAY_PGUSER=relay_n8n
RELAY_PGPASSWORD=
N8N_ENCRYPTION_KEY=
QUANT_WRITE_API_KEY=
APP_GIT_SHA=
APP_RELEASE=
APP_BUILD_CREATED_AT=
FEISHU_ADAPTER_IMAGE=
# Source hotfix overlay for the adapter and LarkAgentX bridge. The hotfix
# script manages these values; leave adapter selection disabled for a normal
# immutable image release.
FEISHU_ADAPTER_HOTFIX_ENABLED=false
FEISHU_ADAPTER_HOTFIX_DIR=/opt/feishu-relay-edge/hotfix
LARKX_BRIDGE_HOTFIX_ROOT=/opt/feishu-relay-edge/hotfix
# Private-session bridge safety. Each profile gets separate credentials,
# SQLite event spool and owner lock under LARKX_HOME. Keep this path on the
# persistent, permission-restricted host filesystem.
LARKX_PROFILE=default
LARKX_HOME=/var/lib/larkagentx
LARKX_EVENT_SPOOL_DB=/var/lib/larkagentx/bridge-events.sqlite3
LARKX_OWNER_LOCK_PATH=/var/lib/larkagentx/bridge.owner.lock
LARKX_SPOOL_REPLAY_SECONDS=30
LARKX_SUMMARY_CHAT_IDS=
LARKX_SUMMARY_INGRESS_URL=http://127.0.0.1:18300/internal/larkagentx/summary
# Forward only explicit Paper-KB commands from otherwise unbound WebSocket
# chats. Ordinary messages remain subject to the normal chat allowlist.
LARKX_PAPER_KB_COMMANDS_ENABLED=true
# Paper-KB runs on the workstation. The local svc supervisor keeps an SSH
# reverse forward on edge:15678 -> workstation:5678, so these command lanes do
# not depend on an n8n workflow copy on the edge host.
PAPER_KB_FEISHU_CHAT_ID=
PAPER_KB_INGEST_WEBHOOK=http://127.0.0.1:15678/webhook/paper-ingest
PAPER_KB_SEARCH_WEBHOOK=http://127.0.0.1:15678/webhook/paper-search
PAPER_KB_FEEDBACK_WEBHOOK=http://127.0.0.1:15678/webhook/paper-feedback
# Itougu's 尾盘掘金/擒龙 update groups are webhook destinations, not
# WebSocket sources. Keep their numeric and oc_ IDs out of the three LARKX
# source/route lists below; otherwise the same product can enter twice.
# Source-scoped WebSocket ingress filters. The phrase is dropped before the
# bridge calls the adapter/webhook; add persisted VIP source keys here when a
# source does not use the literal `anqiang` key.
LARKX_ANQIANG_SOURCE_KEYS=anqiang
LARKX_ANQIANG_CHAT_IDS=
LARKX_ANQIANG_BLOCK_KEYWORDS=般若星登山的川柏
LARKX_GAP_REPAIR_ENABLED=false
# Private LarkAgentX history repair is separate from the official OAuth repair
# lane. Enable it only for verified numeric WebSocket chats; it never calls
# the official message.list endpoint.
LARKX_PRIVATE_GAP_REPAIR_ENABLED=false
LARKX_PRIVATE_GAP_REPAIR_ON_START=false
LARKX_PRIVATE_GAP_REPAIR_CHAT_IDS=
LARKX_PRIVATE_REPAIR_MAX_POSITIONS=64
LARKX_DYNAMIC_ROUTE_DISCOVERY=false
LARKX_ROUTE_CATALOG_URL=http://127.0.0.1:18300/internal/larkagentx/routes
LARKX_ROUTE_CATALOG_REFRESH_SECONDS=15
LARKX_OFFICIAL_FALLBACK_ENABLED=false
# Narrow fallback for WebSocket cards whose body is absent from the protobuf.
# It is separate from the old group polling loop and defaults to disabled.
LARKX_CARD_BACKFILL_ENABLED=false
# Comma-separated source tags allowed to use the narrow card fallback. For
# example: cat. Empty means all sources only when the flag above is enabled.
LARKX_CARD_BACKFILL_TAGS=
# Host-level Itougu API poller heartbeat, mounted read-only into the adapter
# so its status appears beside the LarkAgentX WebSocket groups.
ITOUGU_STATUS_DIR=/var/lib/itougu-neican
ITOUGU_STATUS_FILE=/var/lib/itougu-neican/status.json
ITOUGU_CONTROL_HOST=127.0.0.1
ITOUGU_CONTROL_PORT=18084
ITOUGU_CONTROL_URL=http://127.0.0.1:18084
BAIDU_PAN_MARKET_ARCHIVE_ENABLED=false
BAIDU_PAN_MARKET_ARCHIVE_INTERVAL_SECONDS=30
BAIDU_PAN_MARKET_ARCHIVE_ROOT_PATH=/apps/股票paper存储/market-realtime
# Raw overflow lane (requires QUANT_RAW_OVERFLOW_ARCHIVE_ENABLED=true on the
# edge quant service as well; keep both false until the ACK/restore drill).
BAIDU_PAN_RAW_OVERFLOW_ENABLED=false
BAIDU_PAN_RAW_OVERFLOW_CAPABILITIES=a_share_prices_snapshot,realtime_quote,order_book_quote,rt_k,rt_min,rt_min_daily
BAIDU_PAN_RAW_OVERFLOW_BATCH_ROWS=100
BAIDU_PAN_RAW_OVERFLOW_BATCHES_PER_DRAIN=4
BAIDU_PAN_RAW_OVERFLOW_ROOT_PATH=/apps/股票paper存储/quant-lake/v1/raw-overflow
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_GROUP_RELAY_ENABLED=false
FEISHU_GROUP_RELAY_WEBHOOK_KEYWORDS=
FEISHU_SUMMARY_LISTENER_ENABLED=false
FEISHU_LONG_CONNECTION_ENABLED=false
# Optional Baidu Netdisk personal-app archive. Keep credentials outside Git.
BAIDU_PAN_ENABLED=false
BAIDU_PAN_APP_KEY=
BAIDU_PAN_SECRET_KEY=
BAIDU_PAN_REDIRECT_URI=oob
BAIDU_PAN_ROOT_PATH=/apps/股票paper存储/feishu-relay
BAIDU_PAN_SPOOL_DIR=/var/lib/adapter-ingestion/baidu-pan-spool
BAIDU_PAN_MAX_UPLOAD_BYTES=524288000
BAIDU_PAN_SLICE_BYTES=4194304
BAIDU_PAN_ARCHIVE_PROVIDER=auto

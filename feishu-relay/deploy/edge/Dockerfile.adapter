FROM node:22-alpine

ARG APP_GIT_SHA=unknown
ARG APP_RELEASE=unknown
ARG APP_BUILD_CREATED_AT=unknown

WORKDIR /app
ENV NODE_ENV=production FRONTEND_MODE=spa FRONTEND_DIST=/app/frontend-dist

COPY feishu-relay/adapter/package.json ./
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund

COPY feishu-relay/adapter/index.mjs feishu-relay/adapter/ledger.mjs feishu-relay/adapter/group-relay.mjs \
     feishu-relay/adapter/wechat-group-relay.mjs \
     feishu-relay/adapter/summary-listener.mjs feishu-relay/adapter/message-filter.mjs \
     feishu-relay/adapter/content-filter.mjs feishu-relay/adapter/card-content.mjs \
     feishu-relay/adapter/message-time.mjs feishu-relay/adapter/message-idempotency.mjs \
     feishu-relay/adapter/retry-media.mjs feishu-relay/adapter/feishu-user-oauth.mjs \
     feishu-relay/adapter/feishu-workbench.mjs feishu-relay/adapter/release-metadata.mjs \
     feishu-relay/adapter/stream-write.mjs feishu-relay/adapter/single-flight.mjs \
     feishu-relay/adapter/summary-ingestion-filter.mjs feishu-relay/adapter/ingestion-health.mjs \
     feishu-relay/adapter/paper-ingest-command.mjs feishu-relay/adapter/paper-feedback-command.mjs \
     feishu-relay/adapter/personal-decision-routes.mjs feishu-relay/adapter/baidu-pan-storage.mjs \
     feishu-relay/adapter/baidu-pan-market-archive.mjs feishu-relay/adapter/media-chunks.mjs \
     feishu-relay/adapter/larkagentx-ingress.mjs feishu-relay/adapter/webhook-config.mjs ./
COPY feishu-relay/config/source-registry.json /app/source-registry.json
COPY feishu-relay/adapter/larkagentx-backfill.mjs ./
COPY frontend/dist /app/frontend-dist
ENV APP_GIT_SHA=${APP_GIT_SHA} \
    APP_RELEASE=${APP_RELEASE} \
    APP_BUILD_CREATED_AT=${APP_BUILD_CREATED_AT}
LABEL org.opencontainers.image.revision=${APP_GIT_SHA} \
      org.opencontainers.image.version=${APP_RELEASE} \
      org.opencontainers.image.created=${APP_BUILD_CREATED_AT}

USER root
CMD ["node", "index.mjs"]

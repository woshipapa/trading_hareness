# /etc/systemd/system/itougu-perf-weekly.service
[Unit]
Description=爱投顾内参 个股操作与收益 周报 → 飞书
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/itougu-perf-report.env
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/itougu-neican
ExecStart=/usr/bin/python3 /opt/itougu-neican/itougu_perf_report.py --weekly
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=itougu-neican
ReadWritePaths=/var/lib/itougu-neican
UMask=0077

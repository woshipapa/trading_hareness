# Copy to .env and set real credentials locally. Never commit the real .env.
APP_GIT_SHA=
APP_RELEASE=
APP_BUILD_CREATED_AT=
POSTGRES_PASSWORD=replace-me
N8N_ENCRYPTION_KEY=replace-me
QUANT_WRITE_API_KEY=replace-me
QUANT_ALERT_WEBHOOK_TOKEN=replace-me
FEISHU_APP_ID=replace-me
FEISHU_APP_SECRET=replace-me
QUANT_LONGHU_CONFIG_HOST_PATH=./config/longhu_vendor.example.json
# Longhu's logical quote basket limit is 300. GetStockPanKou is per-symbol.
# Intraday watchlist admission remains separately bounded by
# INTRADAY_WATCHLIST_MAX_SYMBOLS.
QUANT_LONGHU_INTRADAY_MAX_SYMBOLS=300
# Local Longhu reads go through an SSH-forwarded owner gateway. Keep direct
# vendor access disabled on the workstation; enable it only on the licensed
# owner service that stores the vendor credential file.
QUANT_LONGHU_DIRECT_ENABLED=false
QUANT_SHARED_READ_API_BASE_URL=http://host.docker.internal:15682
QUANT_SHARED_READ_API_KEY=
QUANT_ASYNC_READ_POOL_MAX_SIZE=16

# Optional host-side SSH tunnel (do not put private keys or tokens in Git).
LONGHU_SSH_HOST=
LONGHU_SSH_PORT=22
LONGHU_SSH_USER=
LONGHU_SSH_KEY_PATH=
LONGHU_REMOTE_PORT=15682
LONGHU_LOCAL_PORT=15682

# Optional runtime overrides; defaults are defined in compose.yaml.
INTRADAY_SCAN_INTERVAL_SECONDS=30
INTRADAY_SUPER_GET_FAST_INTERVAL_SECONDS=1
INTRADAY_SUPER_GET_FAST_MAX_SYMBOLS=40
INTRADAY_ORDER_BOOK_INTERVAL_SECONDS=3

# 群消息转发：由用户 OAuth 可见性读取外部源群；可改为明确 chat_id。
FEISHU_GROUP_RELAY_ENABLED=true
FEISHU_GROUP_RELAY_INTERVAL_SECONDS=10
FEISHU_GROUP_RELAY_SOURCE_CONCURRENCY=3
# Comma/newline separated promotional/noise terms; defaults include 咸鱼、到期联系等.
FEISHU_MESSAGE_BLOCK_KEYWORDS=
# Smoke-test safety override: set only for a test process; it replaces every
# product-specific destination and must point to the 公众号同步群.
ITOUGU_TEST_CHAT_IDS=
FEISHU_GROUP_RELAY_ACTION_CARDS_ENABLED=false
FEISHU_GROUP_RELAY_HISTORY_LOOKBACK_SECONDS=300
FEISHU_GROUP_RELAY_BOOTSTRAP_MODE=skip_existing
FEISHU_GROUP_RELAY_RECONCILE_SECONDS=21600
FEISHU_GROUP_RELAY_RECONCILE_LOOKBACK_SECONDS=86400
FEISHU_GROUP_RELAY_TARGET_CHAT_ID=oc_523b7e9e29854acba64272a948cb8eda
FEISHU_GROUP_RELAY_ANQIANG_CHAT_ID=oc_1de6464db12c43bf60985f7131e6334a
FEISHU_GROUP_RELAY_ANQIANG_CHAT_NAME=马安强 (1)
FEISHU_GROUP_RELAY_LIWEI_CHAT_ID=oc_4ed9fdb72a152bc921b2d34bd4a1df14
FEISHU_GROUP_RELAY_LIWEI_CHAT_NAME=消息更新群
# Optional dedicated external forwarding group(s) for #liwei, comma-separated.
FEISHU_GROUP_RELAY_LIWEI_TARGET_CHAT_IDS=
FEISHU_GROUP_RELAY_QUANNENG_CHAT_ID=oc_d6a89890c3a62517116a2c63f015e0a0
FEISHU_GROUP_RELAY_QUANNENG_CHAT_NAME=新野人哥会员群【禁言】
# 小杰夜报～：留空 chat_id 时由用户 OAuth 按群名精确解析；转发前自动加 #xiaojie。
FEISHU_GROUP_RELAY_XIAOJIE_CHAT_ID=
FEISHU_GROUP_RELAY_XIAOJIE_CHAT_NAME=小杰夜报～
# Webhook target keywords, in chat_id=keyword;chat_id2=keyword2 format.
FEISHU_GROUP_RELAY_WEBHOOK_KEYWORDS=
FEISHU_ADAPTER_HOTFIX_ENABLED=false
FEISHU_ADAPTER_HOTFIX_DIR=./hotfix
LARKX_GROUP_RELAY_ENABLED=false
# personal_web_chat_id=source_key;personal_web_chat_id2=source_key2
LARKX_GROUP_RELAY_ROUTES=
LARKX_DYNAMIC_ROUTE_DISCOVERY=false
LARKX_ROUTE_CATALOG_URL=http://127.0.0.1:18300/internal/larkagentx/routes
LARKX_ROUTE_CATALOG_REFRESH_SECONDS=15
WECHAT_GROUP_RELAY_ENABLED=false
WECHAT_GROUP_RELAY_SOURCE_KEY=wechat_xiaolan
WECHAT_GROUP_RELAY_SOURCE_CHAT_ID=50136408612@chatroom
WECHAT_GROUP_RELAY_ROUTE_TAG=xiaolan
WECHAT_GROUP_RELAY_TARGET_CHAT_ID=
WECHAT_GROUP_RELAY_ENDPOINT_TOKEN=
WECHAT_GROUP_RELAY_MAX_TEXT_LENGTH=3500
# 汇总群监听：用户和机器人发送的带注册 #标签 消息均会进入 n8n。
FEISHU_SUMMARY_LISTENER_ENABLED=true
FEISHU_SUMMARY_LISTENER_INTERVAL_SECONDS=10
FEISHU_SUMMARY_LISTENER_HISTORY_LOOKBACK_SECONDS=3600
FEISHU_SUMMARY_LISTENER_BOOTSTRAP_MODE=forward_existing
FEISHU_USER_OAUTH_REDIRECT_URI=http://localhost:8080/callback
# LarkAgentX 实验入口：留空则适配器拒绝所有逆向个人会话消息。
# 令牌只放部署环境，不要提交；监听消息仍要求正文首行带已注册的 #标签。
LARKX_BRIDGE_TOKEN=
LARKX_SUMMARY_CHAT_IDS=
LARKX_SUMMARY_INGRESS_URL=http://127.0.0.1:18300/internal/larkagentx/summary
LARKX_GAP_REPAIR_ENABLED=false
LARKX_OFFICIAL_FALLBACK_ENABLED=false
# Only incomplete CARD/INTERACTIVE events may use one bounded official lookup;
# this does not re-enable the old group polling loop.
LARKX_CARD_BACKFILL_ENABLED=false

# 飞书分析师工作台：均为可选。不要把 token、app secret 写入前端或提交到 Git。
# H5 地址必须是飞书开发者后台登记过的公网 HTTPS 域名。
FEISHU_WORKBENCH_PUBLIC_BASE_URL=
FEISHU_WORKBENCH_DRIVE_FOLDER_TOKEN=
FEISHU_WORKBENCH_DRIVE_MAX_FILE_BYTES=524288000
# 百度网盘个人应用（可选；凭据只放在部署环境，不要提交）。大文件归档 provider: auto|feishu|baidu。
BAIDU_PAN_ENABLED=false
BAIDU_PAN_APP_KEY=
BAIDU_PAN_SECRET_KEY=
BAIDU_PAN_REDIRECT_URI=oob
BAIDU_PAN_ROOT_PATH=/apps/股票paper存储/feishu-relay
BAIDU_PAN_SPOOL_DIR=/var/lib/adapter-ingestion/baidu-pan-spool
BAIDU_PAN_MAX_UPLOAD_BYTES=524288000
BAIDU_PAN_SLICE_BYTES=4194304
BAIDU_PAN_ARCHIVE_PROVIDER=auto
FEISHU_WORKBENCH_WIKI_SPACE_ID=
FEISHU_WORKBENCH_WIKI_PARENT_NODE_TOKEN=
FEISHU_WORKBENCH_TASKLIST_GUID=
FEISHU_WORKBENCH_BASE_APP_TOKEN=
FEISHU_WORKBENCH_BASE_TABLE_ID=
FEISHU_WORKBENCH_CALENDAR_ID=
FEISHU_WORKBENCH_APPROVAL_CODE=
FEISHU_WORKBENCH_AILY_APP_ID=
FEISHU_WORKBENCH_ASR_ENGINE_TYPE=16k_auto
# paper-kb job trigger; copy from literature_maps/paper_kb/.jobs_token
PAPER_KB_JOBS_TOKEN=replace-me
# paper-kb reading group + the n8n webhooks that receive 收录 / 查询 commands
PAPER_KB_FEISHU_CHAT_ID=
# Paper-KB sends directly to this dedicated Feishu group bot; it does not use papa-bot.
PAPER_KB_FEISHU_WEBHOOK_URL=
# Optional separate token for the paper-kb outbound adapter route; falls back to QUANT_ALERT_WEBHOOK_TOKEN.
PAPER_KB_ALERT_WEBHOOK_TOKEN=
PAPER_KB_INGEST_WEBHOOK=
PAPER_KB_SEARCH_WEBHOOK=
PAPER_KB_FEEDBACK_WEBHOOK=
# Process ownership: full (legacy/default), research (local), or intraday_edge (server).
QUANT_RUNTIME_PROFILE=full
# Edge-only direct alert transport. Keep false on the local research role.
QUANT_FEISHU_DIRECT_ENABLED=false
DAILY_SUMMARY_FEISHU_ENABLED=true
